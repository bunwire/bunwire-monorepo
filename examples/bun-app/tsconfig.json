{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/example.tsbuildinfo",
    "experimentalDecorators": true,
    "types": ["bun"]
  },
  "include": ["inspect.ts", "src/**/*.ts", ".bunwire/**/*.ts", "worker/**/*.ts", "worker/.bunwire/**/*.ts", "scheduler/**/*.ts", "scheduler/.bunwire/**/*.ts", "command/**/*.ts", "command/.bunwire/**/*.ts", "websocket/**/*.ts", "websocket/.bunwire/**/*.ts"],
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/bun" },
    { "path": "../../packages/vite" }
  ]
}
