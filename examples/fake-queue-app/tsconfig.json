{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "experimentalDecorators": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/example.tsbuildinfo",
    "paths": {
