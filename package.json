{
  "name": "bunwire-monorepo",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:electrobun-sdk-contract": "node tests/electrobun-sdk-contract.mjs",
    "test:electrobun-native": "node tests/electrobun-native-smoke.mjs",
    "test:built-exports": "node tests/built-export-audit.mjs",
    "test:release-pack": "node tests/release-package-audit.mjs",
    "test:cli-pack": "node tests/milestone-23/packed-no-vite.mjs",
    "test:clean-install": "node tests/clean-install.mjs",
    "performance:sanity": "node tests/performance-sanity.mjs",
    "performance:sanity:bun": "vitest run --config vitest.config.ts tests/bun/milestone-16/example-process.test.ts tests/bun/milestone-16/scheduler-worker.test.ts",
    "test:architecture": "vitest run tests/milestone-00/architecture.test.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "quality": "pnpm check:boundaries && pnpm typecheck && pnpm test:electrobun-sdk-contract && pnpm test && pnpm build && pnpm test:built-exports"
  },
  "devDependencies": {
    "@bunwire/bun": "workspace:*",
    "@bunwire/cli": "workspace:*",
    "@bunwire/core": "workspace:*",
    "@bunwire/electrobun": "workspace:*",
    "@bunwire/validation": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "happy-dom": "^21.0.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  }
}
