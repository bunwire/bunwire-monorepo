{
  "name": "@bunwire/bun",
  "version": "0.1.1",
  "description": "Bun-native host adapter, runtime roles, and application integrations for Bunwire.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bunwire/bunwire-monorepo.git",
    "directory": "packages/bun"
  },
  "homepage": "https://github.com/bunwire/bunwire-monorepo#readme",
  "bugs": "https://github.com/bunwire/bunwire-monorepo/issues",
  "keywords": ["bunwire", "bun", "application-framework", "typescript"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist/**/*.js", "dist/**/*.d.ts", "dist/**/*.map", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config ../../vitest.config.ts tests/bun/milestone-01"
  },
  "dependencies": {
    "@bunwire/core": "workspace:^"
  },
  "devDependencies": {
    "@types/bun": "1.4.0"
  }
}
