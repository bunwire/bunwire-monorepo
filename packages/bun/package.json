{
  "name": "@bunwire/bun",
  "version": "0.1.1",
  "description": "Bun-native host adapter, runtime roles, and application integrations for Bunwire.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bunwire/bunwire-monorepo.git",
    "directory": "packages/bun"
  },
  "homepage": "https://github.com/bunwire/bunwire-monorepo#readme",
  "bugs": "https://github.com/bunwire/bunwire-monorepo/issues",
  "keywords": [
    "bunwire",
    "bun",
    "application-framework",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config ../../vitest.config.ts tests/bun"
  },
  "dependencies": {
    "@bunwire/core": "workspace:^",
    "@bunwire/validation": "workspace:^",
    "oauth4webapi": "3.8.7"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  }
}
