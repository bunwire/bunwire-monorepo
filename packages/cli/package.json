{
  "name": "@bunwire/cli",
  "version": "0.1.1",
  "description": "Bunwire project command-line tooling.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bunwire/bunwire-monorepo.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/bunwire/bunwire-monorepo#readme",
  "bugs": "https://github.com/bunwire/bunwire-monorepo/issues",
  "keywords": ["bunwire", "cli", "code-generation"],
  "type": "module",
  "bin": { "bunwire": "./dist/bin.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist/**/*.js", "dist/**/*.d.ts", "dist/**/*.map", "README.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config ../../vitest.config.ts tests/milestone-23"
  },
  "dependencies": { "@bunwire/vite": "workspace:^" }
}
