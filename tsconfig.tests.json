{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "checkJs": false,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "noEmit": true,
    "paths": {
      "@bunwire/bun": ["packages/bun/src/index.ts"],
      "@bunwire/core": ["packages/core/src/index.ts"],
      "@bunwire/vite": ["packages/vite/src/index.ts"],
      "@bunwire/electrobun": ["packages/electrobun/src/index.ts"],
      "@bunwire/test-analysis-extensions": ["tests/fixtures/milestone-8-analysis/extensions.ts"],
      "@bunwire/fake-queue": ["examples/fake-queue-app/src/adapter.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "tests/**/*.test.ts"
  ]
}
