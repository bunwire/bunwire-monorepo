{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "checkJs": false,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "esModuleInterop": true,
    "noEmit": true,
    "paths": {
      "@bunwire/core": ["packages/core/src/index.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "tests/**/*.test.ts"
  ]
}
